{
  "version": 2,
  "builds": [
    { "src": "index.html",    "use": "@vercel/static" },
    { "src": "webinar.html",  "use": "@vercel/static" },
    { "src": "registro.html", "use": "@vercel/static" },
    { "src": "utils.js",        "use": "@vercel/static" },
    { "src": "app.js",         "use": "@vercel/static" },
    { "src": "kanban.js",      "use": "@vercel/static" },
    { "src": "lead-modal.js",  "use": "@vercel/static" },
    { "src": "config-panel.js","use": "@vercel/static" },
    { "src": "messaging.js",   "use": "@vercel/static" },
    { "src": "init.js",        "use": "@vercel/static" },
    { "src": "styles.css",    "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/utils.js",        "dest": "/utils.js"        },
    { "src": "/app.js",         "dest": "/app.js"          },
    { "src": "/kanban.js",      "dest": "/kanban.js"       },
    { "src": "/lead-modal.js",  "dest": "/lead-modal.js"   },
    { "src": "/config-panel.js","dest": "/config-panel.js" },
    { "src": "/messaging.js",   "dest": "/messaging.js"    },
    { "src": "/init.js",        "dest": "/init.js"         },
    { "src": "/styles.css",    "dest": "/styles.css"    },
    { "src": "/webinar.html",  "dest": "/webinar.html"  },
    { "src": "/registro.html", "dest": "/registro.html" },
    { "src": "/(.*)",          "dest": "/index.html"    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
