{
  "version": 2,
  "builds": [
    { "src": "index.html",    "use": "@vercel/static" },
    { "src": "webinar.html",  "use": "@vercel/static" },
    { "src": "registro.html", "use": "@vercel/static" },
    { "src": "app.js",         "use": "@vercel/static" },
    { "src": "config-panel.js","use": "@vercel/static" },
    { "src": "messaging.js",   "use": "@vercel/static" },
    { "src": "styles.css",    "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/app.js",          "dest": "/app.js"          },
    { "src": "/config-panel.js", "dest": "/config-panel.js" },
    { "src": "/messaging.js",    "dest": "/messaging.js"    },
    { "src": "/styles.css",    "dest": "/styles.css"    },
    { "src": "/webinar.html",  "dest": "/webinar.html"  },
    { "src": "/registro.html", "dest": "/registro.html" },
    { "src": "/(.*)",          "dest": "/index.html"    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
